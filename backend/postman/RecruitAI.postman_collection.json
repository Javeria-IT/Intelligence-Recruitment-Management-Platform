              "raw": "{\n  \"jobId\": \"{{jobId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/ai/rankCandidates", "host": ["{{baseUrl}}"], "path": ["api", "ai", "rankCandidates"] }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get My Notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.notifications && res.data.notifications.length) {",
                  "  pm.collectionVariables.set('notificationId', res.data.notifications[0]._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/notifications?unreadOnly=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications"],
              "query": [{ "key": "unreadOnly", "value": "false" }]
            }
          }
        },
        {
          "name": "Mark Notification As Read",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/notifications/read/{{notificationId}}", "host": ["{{baseUrl}}"], "path": ["api", "notifications", "read", "{{notificationId}}"] }
          }
        },
        {
          "name": "Mark All Notifications As Read",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/notifications/read-all", "host": ["{{baseUrl}}"], "path": ["api", "notifications", "read-all"] }
          }
        }
      ]
    }
  ]
}
